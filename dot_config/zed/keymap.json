// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // add helix word jump to vim via enter
  {
    "context": "(vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "enter": "vim::HelixJumpToWord",
    },
  },
  // rebind workspace sidebar
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-j": "multi_workspace::ToggleWorkspaceSidebar",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-cmd-j": "multi_workspace::ToggleWorkspaceSidebar",
    },
  },
  // lazygit popup task
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space g g": [
        "task::Spawn",
        { "task_name": "start lazygit", "reveal_target": "center" },
      ],
      "space g f": [
        "task::Spawn",
        { "task_name": "start lazygit file log", "reveal_target": "center" },
      ],
    },
  },
]
