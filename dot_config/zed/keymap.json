// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "bindings": {
            "cmd->": "window::ShowNextWindowTab",
        },
    },
    {
        "bindings": {
            "cmd-<": "window::ShowPreviousWindowTab",
        },
    },
    {
        "context": "(vim_mode == normal || vim_mode == visual) && !menu",
        "bindings": {
            "enter": "vim::HelixJumpToWord"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-cmd-j": "multi_workspace::ToggleWorkspaceSidebar"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "alt-cmd-j": "multi_workspace::ToggleWorkspaceSidebar"
        }
    }
]
